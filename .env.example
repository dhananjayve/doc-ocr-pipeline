# Copy to .env and adjust. Every setting in src/finpipe/config.py can be set as FINPIPE_<NAME>.

# Ollama model that answers questions (default qwen3:8b)
FINPIPE_SLM_MODEL=gemma4

# Parser processes (0 = auto)
# FINPIPE_WORKERS=0

# How long Ollama keeps the model loaded between questions
# FINPIPE_SLM_KEEP_ALIVE=4h
